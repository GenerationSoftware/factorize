{
  "name": "factorize-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:app && node scripts/dev.mjs",
    "build:css": "npm run build:app",
    "test": "node scripts/validation.mjs all",
    "test:backend": "node scripts/validation.mjs backend",
    "test:browser": "node scripts/validation.mjs browser",
    "test:proxy": "node scripts/validation.mjs proxy",
    "check": "npm test",
    "bootstrap:test": "node scripts/bootstrap-test.mjs",
    "test:local": "node scripts/bootstrap-test.mjs --test",
    "check:backend": "npm run test:backend",
    "check:frontend": "npm run check --workspace=factorize-app",
    "deploy": "npm run deploy:app && npm run deploy:tail-relay",
    "deploy:app": "npm run deploy --workspace=factorize",
    "deploy:tail-relay": "npm run deploy --workspace=factorize-tail-relay",
    "generate:openapi": "npm run generate:openapi --workspace=factorize",
    "check:openapi": "npm run check:openapi --workspace=factorize",
    "dev:api": "npm run dev --workspace=factorize",
    "dev:app": "node scripts/dev-cert.mjs && npm run dev --workspace=factorize-app",
    "build:app": "npm run build --workspace=factorize-app",
    "generate:client": "npm run generate --workspace=factorize-api-client",
    "check:client": "npm run check --workspace=factorize-api-client",
    "check:boundaries": "node --test scripts/check-package-boundaries.test.mjs && node scripts/check-package-boundaries.mjs",
    "generate": "npm run generate:skills && npm run generate:openapi && npm run generate:client",
    "build": "npm run build:app",
    "check:hosting": "node --test scripts/hosting-invariants.test.mjs scripts/deployment-gate.test.mjs scripts/trusted-app-release.test.mjs && python3 scripts/test-retain-app-assets.py",
    "test:hosting-runtime": "node --test --test-name-pattern=hosting scripts/worker-runtime.test.mjs",
    "test:oauth-runtime": "node --test --test-name-pattern=OAuth scripts/worker-runtime.test.mjs",
    "test:conditions-runtime": "node --test scripts/webhook-conditions-runtime.test.mjs",
    "generate:skills": "node scripts/generate-builtin-skills.mjs",
    "check:skills": "node scripts/generate-builtin-skills.mjs --check",
    "test:api": "node scripts/validation.mjs api",
    "test:worker": "node scripts/validation.mjs worker",
    "test:static": "node scripts/validation.mjs static",
    "test:worker-runtime": "node --test scripts/worker-runtime.test.mjs scripts/cloudflare-oauth-runtime.test.mjs"
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=11.19.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "sharp@0.33.5": true,
    "workerd@1.20251118.0": true,
    "workerd@1.20260910.1": true,
    "workerd@1.20261116.1": true,
    "bun@1.4.5": true
  },
  "devDependencies": {
    "bun": "1.4.5"
  }
}
