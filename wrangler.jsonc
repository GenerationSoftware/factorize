{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "factorize",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "cacbf744337747ffbb9c0153329aad4f" }],
  "worker_loaders": [{ "binding": "CUSTOM_HANDLER_LOADER" }],
  "durable_objects": {
    "bindings": [{ "name": "TENANTS", "class_name": "Tenant" }, { "name": "GITHUB_INSTALLATIONS", "class_name": "GitHubInstallationRegistry" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tenant"] }, { "tag": "v2", "new_sqlite_classes": ["GitHubInstallationRegistry"] }],
  "vars": {
    "APP_ORIGIN": "https://app.factorize.sh",
    "LINEAR_OAUTH_SCOPES": "read,write",
    "GITHUB_INTEGRATION_ENABLED": "false",
    "CUSTOM_SOURCES_ENABLED": "true"
  }
}
