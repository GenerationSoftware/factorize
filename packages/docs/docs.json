{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Factorize",
  "theme": "mint",
  "colors": {
    "primary": "#e5a400",
    "light": "#fff8e1",
    "dark": "#17130a"
  },
  "favicon": "/logo-light.svg",
  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "mcp/overview"
            ]
          },
          {
            "group": "Work with your agent",
            "pages": [
              "work/use-an-api",
              "work/vm-access",
              "integrations/aws",
              "work/triggers"
            ]
          },
          {
            "group": "Event sources",
            "pages": [
              "integrations/events",
              "integrations/github",
              "integrations/clickup",
              "integrations/oauth"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/connection",
              "troubleshooting/events"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "mcp/tools",
              "concepts",
              "api/reference",
              "api/authentication",
              "api/discovery",
              "api/openapi",
              {
                "group": "REST operations",
                "openapi": "/openapi.yaml"
              }
            ]
          }
        ]
      },
      {
        "tab": "Operators",
        "groups": [
          {
            "group": "Self-hosting",
            "pages": [
              "self-hosting/deployment",
              "self-hosting/configuration",
              "self-hosting/operations"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/self-hosting",
      "destination": "/self-hosting/deployment"
    }
  ]
}
