{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "factorize",
  "routes": [
    { "pattern": "app.factorize.sh", "custom_domain": true },
    { "pattern": "git.factorize.sh", "custom_domain": true }
  ],
  "main": "src/cloudflare-entry.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "assets": { "directory": "../app/dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "cacbf744337747ffbb9c0153329aad4f" }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "9b6c8a09921d4ee18cdf3723135c82ad" }],
  "artifacts": [{ "binding": "SKILL_ARTIFACTS", "namespace": "factorize-skills", "remote": false }],
  "workflows": [{ "binding": "SKILL_PUSH", "name": "factorize-skill-push", "class_name": "SkillPushWorkflow" }],
  "triggers": { "crons": ["*/5 * * * *"], "events": [{ "type": "cf.artifacts.repo.pushed", "filter": { "namespace": "factorize-skills" }, "targets": [{ "type": "workflow", "workflow_name": "factorize-skill-push" }] }] },
  "ratelimits": [{ "name": "GOOGLE_SIGN_IN_START_LIMIT", "namespace_id": "10430", "simple": { "limit": 15, "period": 60 } }],
  "r2_buckets": [{ "binding": "PROXY_ARTIFACTS", "bucket_name": "factorize-run-artifacts" }],
  "durable_objects": {
    "bindings": [{ "name": "SCHEDULER", "class_name": "AlarmCoordinator" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Tenant"] },
    { "tag": "v2", "new_sqlite_classes": ["GitHubInstallationRegistry"] },
    { "tag": "v3-fresh-durable-objects", "new_sqlite_classes": ["TenantV2", "GitHubInstallationRegistryV2"] },
    { "tag": "v4-auth-store", "new_sqlite_classes": ["AuthStore"] },
    { "tag": "v5-postgres-alarm-coordinator", "new_sqlite_classes": ["AlarmCoordinator"] },
    { "tag": "v6-postgres-cutover", "deleted_classes": ["Tenant", "GitHubInstallationRegistry", "TenantV2", "GitHubInstallationRegistryV2", "AuthStore"] }
  ],
  "vars": {
    "APP_ORIGIN": "https://app.factorize.sh",
    "MARKETING_ORIGIN": "https://factorize.sh",
    "LINEAR_OAUTH_SCOPES": "read,write",
    "POSTMARK_FROM_EMAIL": "contact@g9software.xyz",
    "POSTMARK_MESSAGE_STREAM": "outbound"
  }
}
