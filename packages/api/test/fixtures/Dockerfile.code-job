FROM node:24.12.0-bookworm-slim@sha256:7326fb2dbdce998edd72140946851be64ef4a643e8715e138ca467e8e9d92c99
RUN apt-get update && apt-get install -y --no-install-recommends python3 openssl util-linux bash ca-certificates && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash exedev
CMD ["sleep", "infinity"]
