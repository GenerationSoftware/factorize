# Create .dev.vars from this file. Never commit real values.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Copy this once from the Webhooks section of the Linear OAuth app settings.
LINEAR_WEBHOOK_SIGNING_SECRET=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
# base64-encoded 32 random bytes: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# a separate random value for signed browser sessions
SESSION_SIGNING_SECRET=
# Set only in local development to return reset tokens in the response. Keep unset in production.
AUTH_RESET_RETURN_TOKEN=false
