{
  "name": "factorize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:css && wrangler dev",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/styles.css --minify",
    "check": "npm run check:api-boundaries && tsc --noEmit && vitest run && wrangler deploy --dry-run",
    "check:api-boundaries": "node scripts/check-api-boundaries.mjs",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "db:migrate": "node scripts/migrate.mjs",
    "db:verify": "node scripts/verify-schema.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cron-parser": "^5.10.1",
    "hono": "^4.11.4",
    "mustache": "^4.2.0",
    "pg": "8.16.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.10",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@tailwindcss/cli": "^4.1.14",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.15.5",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.44.0"
  }
}
